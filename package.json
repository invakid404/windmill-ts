{
  "name": "windmill-ts",
  "version": "1.9.0",
  "description": "Type-safe client for Windmill",
  "main": "dist/src/index.js",
  "bin": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "rimraf dist/ && tsc",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "Tsvetomir Bonev <me@invak.id>",
  "license": "Unlicense",
  "devDependencies": {
    "@types/node": "24.13.3",
    "rimraf": "6.1.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@stdlib/string-camelcase": "0.2.3",
    "@stdlib/string-capitalize": "0.3.1",
    "chalk": "5.6.2",
    "cli-spinners": "3.4.0",
    "commander": "15.0.0",
    "dedent": "1.7.2",
    "json-schema-to-zod": "2.8.1",
    "log-update": "7.2.0",
    "minimatch": "10.2.6",
    "p-queue": "9.3.3",
    "p-retry": "8.0.1",
    "to-valid-identifier": "1.0.0",
    "ts-morph": "28.0.0",
    "windmill-client": "1.801.0",
    "yaml": "2.9.0",
    "zod": "4.5.4",
    "zod-to-json-schema": "3.25.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<5.0.5": "5.0.9",
      "picomatch@<4.0.4": "4.0.7"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/invakid404/windmill-ts.git"
  },
  "bugs": {
    "url": "https://github.com/invakid404/windmill-ts/issues"
  },
  "homepage": "https://github.com/invakid404/windmill-ts#readme",
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5"
